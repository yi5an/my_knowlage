# Production frontend image: build the SPA, then serve via nginx.
FROM node:20-alpine AS build

WORKDIR /app

# Install deps with cached layer.
COPY package*.json ./
RUN npm ci

# Build the production bundle (outputs /app/dist).
COPY . .
RUN npm run build


FROM nginx:alpine

# Replace default site config.
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Static assets from the build stage.
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
