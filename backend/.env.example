# Market data provider used by the investment event-study service.
# Stooq is a credential-free CSV source; tests inject an in-memory provider.
MARKET_DATA_PROVIDER=stooq
MARKET_DATA_BASE_URL=https://stooq.com
MARKET_DATA_TIMEOUT_SECONDS=30
MARKET_DATA_MAX_LOOKBACK_DAYS=30
MARKET_DATA_EXCHANGE_TIMEZONE=America/New_York
