# yt-dlp uses Deno to solve YouTube's external JavaScript challenges.
FROM denoland/deno:bin-2.5.6 AS deno

# Production backend image: runtime deps only (no dev/test tooling).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# ASR fallback depends on ffmpeg/ffprobe to inspect and split downloaded audio.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=deno /deno /usr/local/bin/deno

# Install runtime dependencies first for better layer caching.
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e .

# Application code + alembic migrations + entrypoint.
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini ./
COPY scripts ./scripts

RUN chmod +x scripts/start_prod.sh

# Persistent uploaded files live here (named volume mounted at runtime).
RUN mkdir -p /app/storage
VOLUME ["/app/storage"]

EXPOSE 8010

CMD ["sh", "scripts/start_prod.sh"]
