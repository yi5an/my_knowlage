KNOWPILOT_ENV=development
KNOWPILOT_DEBUG=true
KNOWPILOT_LOG_LEVEL=INFO
KNOWPILOT_API_V1_PREFIX=/api/v1
KNOWPILOT_CORS_ORIGINS=http://localhost:5173

POSTGRES_DB=knowpilot
POSTGRES_USER=knowpilot
POSTGRES_PASSWORD=knowpilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://knowpilot:knowpilot@postgres:5432/knowpilot
LOCAL_STORAGE_DIR=./backend/storage

# Required only when saving model API Keys through Settings → Model Management.
# Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this value stable across restarts; it encrypts database credentials and must never be committed.
MODEL_ENCRYPTION_KEY=

# LLM (OpenAI-compatible) fallback. Database model management takes precedence
# when a default LLM route exists; keep these for first deployment/offline tests.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_MAX_OUTPUT_TOKENS=8192

# Web search provider for the deep-research agent (Tavily).
# Get a key at https://tavily.com. Leave unset to use a mock search client
# locally; production research tasks require a real key.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_MAX_RESULTS=5

# --- Investment information system (real data sources) --------------------
# Production MUST NOT use mock data. When a required key/UA is missing the
# corresponding fetcher raises SourceConfigError (no fake items). Leave unset
# here so each deployment opts in explicitly.
INVESTMENT_SCHEDULER_ENABLED=true
INVESTMENT_POLL_INTERVAL_SECONDS=60
INVESTMENT_HTTP_TIMEOUT_SECONDS=30
# SEC EDGAR requires a declared User-Agent (doc 01 §2.2). Format: Name/email.
SEC_USER_AGENT=
SEC_MAX_REQUESTS_PER_SECOND=5
# FRED requires a key (https://fred.stlouisfed.org/docs/api/api_key.html).
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred
# BLS works without a key (lower limits); register one for higher limits.
BLS_API_KEY=
BLS_BASE_URL=https://api.bls.gov/publicAPI/v2
# Optional proxy used only by X RSSHub/Nitter sources. Helpful when a server
# cannot reach public X/mirror routes directly.
X_HTTP_PROXY=
# Bright Data X/Twitter scraper API key. Required for x_brightdata sources.
BRIGHTDATA_API_KEY=
BRIGHTDATA_TIMEOUT_SECONDS=120

# Optional explicit proxy for YouTube/Google metadata, subtitles and audio
# downloads. Production currently uses the verified LAN proxy:
# YOUTUBE_PROXY_URL=http://192.168.1.12:7892
YOUTUBE_PROXY_URL=

# Production Compose writes pasted Cookie text to its backend-only private
# volume. Never put Cookie text or a Cookie file path in this .env file.
# YOUTUBE_COOKIES_FILE=/app/private/youtube-cookies.txt

# YouTube visual OCR enrichment. Start the internal PaddleOCR service before
# enabling this in production.
YOUTUBE_VISUAL_ANALYSIS_ENABLED=false
YOUTUBE_FRAME_INTERVAL_SEC=45
YOUTUBE_FRAME_MAX_COUNT=24
YOUTUBE_FRAME_MIN_TEXT_CHARS=12
YOUTUBE_FRAME_SIMILARITY_THRESHOLD=6
OCR_BASE_URL=http://paddleocr:8866
OCR_TIMEOUT_SECONDS=60

# ASR fallback for YouTube videos without usable captions.
ASR_ENABLED=true
GLM_ASR_API_KEY=
GLM_ASR_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_ASR_MODEL=glm-asr-2512
ASR_FALLBACK_API_KEY=
ASR_FALLBACK_BASE_URL=
ASR_FALLBACK_MODEL=
ASR_MIN_CHARS_PER_SEGMENT=4
ASR_SEGMENT_SEC=28
# Leave empty for auto-detect. Do not reuse YOUTUBE_PREFERRED_LANGUAGE here:
# a caption preference like "en" can make Chinese speech transcribe as empty.
ASR_LANGUAGE=

# Mac X 网页采集器（tools/x-collector）使用独立配置文件，不要在这里填写浏览器 Cookie。
# KNOWPILOT_URL=http://127.0.0.1:8010
# X_COLLECTOR_ID=my-mac
# X_COLLECTOR_TOKEN=
